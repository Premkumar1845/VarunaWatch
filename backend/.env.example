# VarunaWatch Backend Environment Variables
# Copy this to .env and fill in your values

# ---- App ----
APP_NAME=VarunaWatch API
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Gemini AI ----
# Get your key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# ---- Supabase (PostGIS) ----
# Create project: https://supabase.com/dashboard
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# ---- Demo Mode ----
# Set to true to use pre-computed demo data (no external APIs needed)
USE_DEMO_DATA=true
