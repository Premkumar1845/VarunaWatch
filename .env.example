# ==============================================================================
# VarunaWatch Environment Variables (.env.example)
# Copy this to .env (backend/.env or frontend/.env.local) and fill in credentials
# ==============================================================================

# ----------------- AI Copilot & Reasoning (Google Gemini) -----------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# ----------------- Weather & Marine Telemetry (Tomorrow.io) ----------------
TOMORROW_API_KEY=your_tomorrow_io_api_key_here
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_API_URL=https://api.open-meteo.com/v1

# ----------------- Mapbox GIS & Satellite Tiles (Frontend) ----------------
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ----------------- Earth Observation (Google Earth Engine) -----------------
GEE_API_KEY=your_gee_api_key_here
GEE_PROJECT_ID=varunawatch-prod

# ----------------- Twilio Emergency Voice & Alert Relay -------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_EMERGENCY_CONTACT=+91XXXXXXXXXX

# ----------------- Database & Runtime Configuration -----------------------
DATABASE_URL=postgresql://postgres:varunapassword@localhost:5432/varuna
USE_DEMO_DATA=true
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
